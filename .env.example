# Obtain a pooled connection string from Neon; never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Use the exact canonical origin in production. Passkeys are tied to this hostname.
BETTER_AUTH_URL=http://localhost:3000
# Dedicated Easymail key bound to a verified SMTP sender.
EASYMAIL_API_KEY=replace-with-your-easymail-api-key
